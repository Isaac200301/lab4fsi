# Copiar como server/.env y reemplazar los valores localmente. Nunca subir el archivo .env.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/folio?retryWrites=true&w=majority
JWT_SECRET=<secreto-largo-aleatorio-de-al-menos-32-caracteres>
CLIENT_ORIGIN=http://localhost:3000
PORT=4000
PAYPAL_CLIENT_ID=<sandbox-client-id>
PAYPAL_CLIENT_SECRET=<sandbox-client-secret>
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Credenciales de las cuentas creadas por el seed (solo desarrollo y pruebas)
SEED_ADMIN_PASSWORD=<contraseña-del-administrador-de-prueba>
SEED_CLIENT_PASSWORD=<contraseña-del-cliente-de-prueba>
